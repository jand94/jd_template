# Host-Ports des Dev-Stacks.
# Im Compose-Netzwerk bleiben Backend (8000), Frontend (3000), PostgreSQL (5432) und Redis (6379) fest.

BACKEND_PORT=8022
FRONTEND_PORT=3022
POSTGRES_PORT=5422
REDIS_PORT=6322

POSTGRES_DB=jd_pmgt
POSTGRES_USER=jd_pmgt
POSTGRES_PASSWORD=jd_pmgt

# Sichtbare Namen für API, Admin und E-Mails.
PROJECT_NAME=jd_Template
API_TITLE=jd_Template API
API_DESCRIPTION=HTTP-API für JD_Template
API_VERSION=0.1.0
DEFAULT_FROM_EMAIL=JD_Template@localhost

# Wird beim Start des Backends angelegt, falls der Benutzer noch fehlt.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=jd_pmgt
