# Kopieren nach docker/.env.prod. SECRET_KEY ersetzen, bevor der Stack erreichbar ist.
# DEBUG bleibt aus. Cookies und der HTTPS-Redirect folgen daraus.
# Der TLS-Abschluss setzt X-Forwarded-Proto und verwirft den Wert vom Client.

BACKEND_PORT=8000
FRONTEND_PORT=3000

POSTGRES_DB=jd_template
POSTGRES_USER=jd_template
POSTGRES_PASSWORD=replace-this-database-password

DEBUG=false
SECRET_KEY=change-me-before-deploy-000000000000000000000000000000000000
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
SERVE_MEDIA=true

ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

PROJECT_NAME=jd_template
API_TITLE=jd_template API
API_DESCRIPTION=HTTP-API für jd_template
API_VERSION=0.1.0
DEFAULT_FROM_EMAIL=jd_template@example.com

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-this-admin-password
