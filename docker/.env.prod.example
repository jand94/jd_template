# Kopieren nach docker/.env.prod. SECRET_KEY ersetzen, bevor der Stack erreichbar ist.
# DEBUG bleibt aus. Cookies und der HTTPS-Redirect folgen daraus.
# Der TLS-Abschluss setzt X-Forwarded-Proto und verwirft den Wert vom Client.

FRONTEND_PORT=3000

POSTGRES_DB=jd_template
POSTGRES_USER=jd_template
POSTGRES_PASSWORD=replace-this-database-password
REDIS_PASSWORD=replace-this-redis-password

DEBUG=false
SECRET_KEY=change-me-before-deploy-000000000000000000000000000000000000
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
SERVE_MEDIA=true

ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
FRONTEND_ORIGIN=https://example.com

PROJECT_NAME=jd_template
API_TITLE=jd_template API
API_DESCRIPTION=HTTP-API für jd_template
API_VERSION=0.1.0
DEFAULT_FROM_EMAIL=jd_template@example.com

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-this-admin-password

# TLS am Prod-Proxy. FRONTEND_PORT ist der HTTPS-Port auf dem Host.
# generate: Root-CA und Serverzertifikat wie in der Entwicklung.
#   Immer enthalten: localhost, 127.0.0.1, Hostname, IPv4-Adressen.
#   PROD_CERT_DNS hängt weitere DNS-Namen an, kommagetrennt.
#   Die Root-CA für Clients liegt danach in docker/certs/prod/prod-ca.crt.
# own: vorhandenes Zertifikat. PROD_TLS_CERT und PROD_TLS_KEY sind Pfade,
#   absolut oder relativ zum Projektroot. PROD_CERT_DNS bleibt dann ungenutzt.
PROD_TLS_MODE=generate
PROD_CERT_DNS=example.com
PROD_TLS_CERT=
PROD_TLS_KEY=
