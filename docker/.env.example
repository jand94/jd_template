# Host-Ports des Dev-Stacks.
# Im Compose-Netzwerk bleiben Backend (8000), Frontend (3000), PostgreSQL (5432) und Redis (6379) fest.
# Kopieren nach docker/.env und die Host-Ports anpassen, wenn sie belegt sind.

BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=jd_template
POSTGRES_USER=jd_template
POSTGRES_PASSWORD=jd_template

DEBUG=true
SECRET_KEY=django-insecure-local-dev-only-replace-for-any-shared-environment
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SERVE_MEDIA=true

# Sichtbare Namen für Frontend, API, Admin und E-Mails.
PROJECT_NAME=jd_template
API_TITLE=jd_template API
API_DESCRIPTION=HTTP-API für jd_template
API_VERSION=0.1.0
DEFAULT_FROM_EMAIL=jd_template@localhost

# Wird beim Start des Backends angelegt, falls der Benutzer noch fehlt.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=jd_template
